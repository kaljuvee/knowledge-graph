# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# TMDB / OMDB APIs
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_API_READ_TOKEN=your_tmdb_read_token_here
OMDB_API_KEY=your_omdb_api_key_here

# Neo4j Aura Cloud
AURA_NEO4J_URI=neo4j+s://your-instance-id.databases.neo4j.io
AURORA_NEO4J_USER=your_aura_username
AURORA_NEO4J_PASSWORD=your_aura_password

# Neo4j Local (Optional - can be set in UI)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_password_here
